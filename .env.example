# ==============================================================================
# Linux Hardware Q&A Assistant - Environment Configuration
# ==============================================================================

# LLM Provider Selection: "claude", "ollama", or "mock" (default for offline demo/tests)
LLM_PROVIDER=mock

# Anthropic Claude API Configuration (Required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Ollama Local Configuration (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# System Execution Safety Settings
EXECUTION_TIMEOUT_SECONDS=5.0
ALLOW_SUDO_DMIDECODE=true

# Mock Mode Configuration
# Set HW_MOCK=true to simulate a Linux hardware environment (e.g. on Windows/macOS or for CI testing)
HW_MOCK=auto
# Simulated hardware profile: "thinkpad_x1", "dell_xps", "gaming_desktop", or "acer_budget"
MOCK_PROFILE=thinkpad_x1

# Server & UI Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

